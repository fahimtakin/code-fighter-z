{
  "name": "code-fighter-z",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-node-snapshot tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--no-node-snapshot tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-node-snapshot vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-node-snapshot vitest",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest run tests/integration",
    "services:up": "docker compose up -d postgres redis",
    "services:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "ratelimit:reset": "tsx scripts/reset-rate-limits.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcrypt": "^6.0.0",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.8.2",
    "isolated-vm": "^7.0.1",
    "jose": "^6.2.12",
    "next": "16.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
