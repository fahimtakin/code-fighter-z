# Copy to .env.local and fill in. Never commit real secrets.

# Required: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Defaults match docker-compose.yml (`npm run services:up`).
DATABASE_URL=postgres://codefighter:codefighter@localhost:5433/codefighter
REDIS_URL=redis://localhost:6380

# Optional
# PORT=3000
# LOG_LEVEL=info
# TRUST_PROXY=false          # true only behind a reverse proxy you control
# ALLOWED_ORIGINS=           # extra origins allowed to open WebSockets, comma-separated
